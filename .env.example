# --- DATABASE CONFIGURATION ---
# local SQLite database URL (development default)
# DATABASE_URL="file:./prisma/dev.db"
#
# production MySQL / MariaDB connection string
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DBNAME"

# --- SECURITY ---
# Secret key used to sign JWT tokens
JWT_SECRET="dein-langes-zufaelliges-secret"

# --- ENVIRONMENT ---
NODE_ENV="production"
PORT=3000

# --- EMAIL DELIVERY (RESEND) ---
RESEND_API_KEY="re_yourApiKeyHere"

# --- WEB PUSH NOTIFICATIONS ---
VAPID_PUBLIC_KEY="yourVapidPublicKeyHere"
VAPID_PRIVATE_KEY="yourVapidPrivateKeyHere"
VAPID_EMAIL="mailto:yourEmailAddressHere"
