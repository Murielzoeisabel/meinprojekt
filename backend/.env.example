# Database configuration (MySQL / MariaDB connection string)
DATABASE_URL="mysql://BENUTZER:PASSWORT@SERVER_URL:3306/DATENBANKNAME"

# Security (Secret key used to sign JWT tokens)
JWT_SECRET="your-very-secure-jwt-secret-key-here"

# CORS and Frontend configuration (URL of the frontend dev server)
FRONTEND_ORIGIN="http://localhost:5173"

# Resend API configuration (API Key from resend.com for email delivery)
RESEND_API_KEY="re_yourApiKeyHere"

# Web Push VAPID keys
VAPID_PUBLIC_KEY="yourVapidPublicKeyHere"
VAPID_PRIVATE_KEY="yourVapidPrivateKeyHere"
VAPID_EMAIL="mailto:yourEmailAddressHere"

# Environment (development or production)
NODE_ENV="production"

